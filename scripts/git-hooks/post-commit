#!/bin/sh
# Auto-push to GitHub after every commit.
# Requires GITHUB_PERSONAL_ACCESS_TOKEN environment variable (set as a Replit secret).

if [ -z "$GITHUB_PERSONAL_ACCESS_TOKEN" ]; then
  echo "[git-hook] GITHUB_PERSONAL_ACCESS_TOKEN not set — skipping GitHub push." >&2
  exit 0
fi

# Refresh credentials from the current token every time
git config --global credential.helper store
printf "https://x-oauth-basic:%s@github.com\n" "$GITHUB_PERSONAL_ACCESS_TOKEN" > "$HOME/.git-credentials"
chmod 600 "$HOME/.git-credentials"

# Try a fast-forward push first
git push github main --quiet 2>/dev/null && exit 0

# If that failed, GitHub may have commits we don't — fetch and merge, then retry
git fetch github main --quiet 2>/dev/null
git merge github/main --no-edit --quiet 2>/dev/null

# Push the merged result
git push github main --quiet 2>&1 | grep -Ev "Everything up-to-date|^$" || true
